# Comma-separated approved HTTPS origins, with no trailing slash.
# Empty denies production commands. No cloud provisioning is authorized here.
ALLOWED_ORIGINS=
# Hosted launch only: exact reviewer UIDs. Empty denies hosted Ask; never put this in VITE_*.
# Isolated demo-threadline emulators allow any authenticated room member without this list.
AI_TESTER_UIDS=
# Optional dedicated Cloud Functions runtime identity; leave unset for isolated emulators.
FUNCTION_SERVICE_ACCOUNT=
